NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never add NEXT_PUBLIC_ to these names.
BROWSER_USE_API_KEY=
# Optional document-reading fallback for scanned PDFs/images and incomplete text extraction.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
SUPABASE_SECRET_KEY=
# Alternatively, use a legacy Supabase service-role key:
# SUPABASE_SERVICE_ROLE_KEY=
